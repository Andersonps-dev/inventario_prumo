DATABASE_URL="postgresql://prumo:prumo@localhost:5434/prumo?schema=public"
# Gere um valor real e único por ambiente — nunca reaproveite este arquivo
# como .env de verdade. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="defina-uma-string-aleatoria-de-verdade-aqui"
JWT_EXPIRES_IN="8h"
PORT=3400
# Origem exata do frontend em produção (sem isso, CORS_ORIGIN vazio libera qualquer origem em dev).
CORS_ORIGIN="https://seu-dominio.com"
